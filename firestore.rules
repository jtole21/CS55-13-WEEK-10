rules_version = '2';
service cloud.firestore {
  // Shelfside keeps independent bookstores in the bookstores collection.
  // Visitor notes live in a ratings subcollection under each shop.

  // True when a field is present before and after the write and the value matches.
  function unchanged(key) {
    return (key in resource.data)
      && (key in request.resource.data)
      && (resource.data[key] == request.resource.data[key]);
  }

  // A new shop must name itself and record the shelf, city, and price level.
  function validBookstore(data) {
    return data.keys().hasAll(["name", "category", "city", "price", "photo"])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() < 120
      && data.category is string
      && data.city is string
      && data.price is number
      && data.price >= 1
      && data.price <= 4;
  }

  // A visitor note needs a star rating, the note text, the author, and a time.
  function validNote(data) {
    return data.keys().hasAll(["rating", "text", "userId", "timestamp"])
      && data.rating is number
      && data.rating >= 1
      && data.rating <= 5
      && data.text is string
      && data.text.size() > 0
      && data.text.size() < 2000
      && data.userId is string
      && data.timestamp is timestamp;
  }

  match /databases/{database}/documents {
    match /bookstores/{bookstoreId} {
      // Anyone can browse the guide. Writes require a signed-in visitor.
      allow read: if true;
      allow create: if request.auth != null
                    && validBookstore(request.resource.data);
      // Photo uploads and rating totals may change.
      // The published name, shelf, city, and price stay fixed.
      allow update: if request.auth != null
                    && unchanged("name")
                    && unchanged("category")
                    && unchanged("city")
                    && unchanged("price");
      allow delete: if false;

      match /ratings/{ratingId} {
        allow read: if true;
        // Notes are written by the signed-in visitor, or they are the
        // labeled sample notes inserted by Add sample bookstores.
        allow create: if request.auth != null
                      && validNote(request.resource.data)
                      && (request.resource.data.userId == request.auth.uid
                          || request.resource.data.userId.matches("^Sample:.*"));
        allow update, delete: if false;
      }
    }
  }
}
