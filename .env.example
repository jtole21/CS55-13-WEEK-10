# Copy to .env.local for local development against a Firebase project.
# Leave these unset on App Hosting. App Hosting injects the web app config.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Used by the Gemini summary on each bookstore page.
# Create a key in Google AI Studio, then add the same value as an
# App Hosting secret named GEMINI_API_KEY.
GEMINI_API_KEY=

# Set to 1 to browse the local catalog before a Firebase project is connected.
# Leave this unset on App Hosting.
NEXT_PUBLIC_SHELFSIDE_PREVIEW=

# Set to 1 only when the Firebase emulators are running locally.
NEXT_PUBLIC_FIREBASE_EMULATOR=
