rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Shop photos are stored at images/<bookstoreId>/<file name>.
    match /images/{bookstoreId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches("image/.*");
    }
  }
}
